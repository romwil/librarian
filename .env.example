# Household owner (seeded on first boot). Password must be ≥ 8 characters.
LIBRARIAN_OWNER_USERNAME=owner
LIBRARIAN_OWNER_PASSWORD=
LIBRARIAN_SESSION_SECRET=

# SABnzbd on Automat
SABNZBD_URL=http://downloader.sl
SABNZBD_API_KEY=

# NZBFinder Newznab v2 — never commit a real token
NZBFINDER_URL=https://nzbfinder.ws
NZBFINDER_API_TOKEN=

# Data share (Unraid). Inside the container this is /data.
DATA_HOST=/mnt/user/data
DATA_DIR=./config
PORT=8793
HOST=0.0.0.0
TZ=America/New_York

# Optional BYO LLM (same shape as Smart Map / Projectionist)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
