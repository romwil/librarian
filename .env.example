# Household owner (seeded on first boot). Password must be ≥ 8 characters.
LIBRARIAN_OWNER_USERNAME=owner
LIBRARIAN_OWNER_PASSWORD=
# Long random value. The public default librarian-dev-session-secret is refused.
LIBRARIAN_SESSION_SECRET=
# Opt-in. Set to 1 only behind a trusted TLS reverse proxy. Default off.
LIBRARIAN_TRUST_PROXY_HEADERS=

# SABnzbd on Automat
SABNZBD_URL=http://downloader.sl
SABNZBD_API_KEY=

# NZBFinder Newznab v2 — never commit a real token
NZBFINDER_URL=https://nzbfinder.ws
NZBFINDER_API_TOKEN=

# Data share (Unraid). Inside the container this is /data.
DATA_HOST=/mnt/user/data
# Optional: host path that maps SAB's /downloads complete folder for this process.
COMPLETE_ROOT=
DATA_DIR=./config
PORT=8793
HOST=0.0.0.0
TZ=America/New_York
PUID=99
PGID=100

# Optional BYO LLM (same shape as Smart Map / Projectionist)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional Hardcover GraphQL token (settings.json preferred). Never commit a real token.
HARDCOVER_API_TOKEN=
# Optional Comic Vine key for comic issue lists. Never commit a real key.
COMICVINE_API_KEY=
# Optional Audiobookshelf match (settings.json preferred; not a Plex replacement). Never commit a real token.
AUDIOBOOKSHELF_URL=
AUDIOBOOKSHELF_API_TOKEN=

# Optional extra Find categories (Movies/TV/XXX). Off by default. Never commit real keys.
SHOW_EXTRA_CATEGORIES=
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
SAB_MOVIE_CATEGORY=
SAB_TV_CATEGORY=
